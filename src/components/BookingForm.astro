---
import Icon from './Icon.astro';
import { site, makes } from '../data/site';

const tasks = [
  'Компьютерная диагностика',
  'Плановое ТО',
  'Диагностика и ремонт DSG',
  'Ремонт подвески',
  'Ремонт тормозов',
  'Ремонт двигателя',
  'Электрика',
  'Кондиционер и отопитель',
  'Диагностика перед покупкой',
  'Замена масла и фильтров',
];
---

<form class="booking" id="book" data-booking novalidate aria-labelledby="book-title">
  <h2 class="sr-only" id="book-title">Запись на СТО</h2>

  <fieldset class="booking__makes">
    <legend class="booking__label">Марка</legend>
    <div class="seg" role="radiogroup">
      {makes.map((m) => (
        <label class="seg__item">
          <input type="radio" name="make" value={m.name} data-make-id={m.id} />
          <span>{m.name}</span>
        </label>
      ))}
    </div>
  </fieldset>

  <div class="booking__row">
    <div class="field">
      <label class="booking__label" for="b-model">Модель, год, двигатель</label>
      <input id="b-model" name="model" type="text" autocomplete="off" placeholder="Например, Passat B8 2016, 2.0 TDI" />
    </div>
    <div class="field">
      <label class="booking__label" for="b-task">Что нужно сделать</label>
      <input id="b-task" name="task" type="text" list="b-tasks" autocomplete="off" placeholder="Рывки DSG, ТО, стук в подвеске…" />
      <datalist id="b-tasks">
        {tasks.map((t) => <option value={t} />)}
      </datalist>
    </div>

    <fieldset class="booking__channel">
      <legend class="booking__label">Куда отправить</legend>
      <div class="seg seg--icons" role="radiogroup">
        <label class="seg__item" title="Telegram">
          <input type="radio" name="channel" value="telegram" checked />
          <span><Icon name="telegram" size={18} /> Telegram</span>
        </label>
        <label class="seg__item" title="Viber">
          <input type="radio" name="channel" value="viber" />
          <span><Icon name="viber" size={18} /> Viber</span>
        </label>
        <label class="seg__item" title="WhatsApp">
          <input type="radio" name="channel" value="whatsapp" />
          <span><Icon name="whatsapp" size={18} /> WhatsApp</span>
        </label>
      </div>
    </fieldset>

    <button class="btn booking__submit" type="submit">
      Записаться
      <Icon name="arrow" />
    </button>
  </div>

  <p class="booking__status" data-booking-status role="status" aria-live="polite">
    Заявка откроется в мессенджере с готовым текстом. Или позвоните: <a class="num" href={`tel:${site.service.tel}`}>{site.service.label}</a>
  </p>
</form>

<script is:inline define:vars={{ tel: site.service.tel, tg: site.messengers.telegram, wa: site.messengers.whatsapp }}>
  (() => {
    const form = document.querySelector('[data-booking]');
    if (!form) return;
    const status = form.querySelector('[data-booking-status]');
    const initial = status.innerHTML;

    const say = (html, kind) => {
      status.innerHTML = html;
      status.dataset.kind = kind || '';
    };

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const data = new FormData(form);
      const make = data.get('make');
      const model = (data.get('model') || '').toString().trim();
      const task = (data.get('task') || '').toString().trim();
      const channel = data.get('channel') || 'telegram';

      if (!make) {
        say('Выберите марку автомобиля — так мастер сразу поймёт, с чем работать.', 'error');
        form.querySelector('input[name="make"]').focus();
        return;
      }
      if (!task) {
        say('Напишите коротко, что нужно сделать: например, «ТО» или «рывки при переключении».', 'error');
        form.querySelector('#b-task').focus();
        return;
      }

      const lines = [
        'Здравствуйте! Хочу записаться на СТО.',
        `Марка: ${make}`,
        model && `Модель: ${model}`,
        `Задача: ${task}`,
      ].filter(Boolean);
      const text = lines.join('\n');
      const enc = encodeURIComponent(text);

      let copied = false;
      try {
        await navigator.clipboard.writeText(text);
        copied = true;
      } catch (_) {}

      if (channel === 'whatsapp') {
        window.open(`${wa}?text=${enc}`, '_blank', 'noopener');
        say('Открываем WhatsApp с готовым текстом заявки. Остаётся нажать «Отправить».', 'ok');
      } else if (channel === 'viber') {
        window.location.href = `viber://chat?number=${encodeURIComponent(tel)}&draft=${enc}`;
        say(
          copied
            ? 'Открываем Viber. Текст заявки скопирован — если поле пустое, вставьте его в чат.'
            : 'Открываем Viber. Если приложение не открылось, напишите на ' + tel + '.',
          'ok'
        );
      } else {
        window.open(tg, '_blank', 'noopener');
        say(
          copied
            ? 'Текст заявки скопирован. Вставьте его в открывшийся чат Telegram и отправьте.'
            : 'Открываем Telegram. Напишите марку, модель и задачу — ответим в рабочее время.',
          'ok'
        );
      }
    });

    form.addEventListener('input', () => {
      if (status.dataset.kind === 'error') say(initial, '');
    });

    // Any [data-pick-make] on the page loads that make into the configurator.
    document.addEventListener('click', (e) => {
      const t = e.target.closest('[data-pick-make], [data-pick-task]');
      if (!t) return;
      e.preventDefault();
      const id = t.getAttribute('data-pick-make');
      const task = t.getAttribute('data-pick-task');
      if (id) {
        const r = form.querySelector(`input[data-make-id="${id}"]`);
        if (r) r.checked = true;
      }
      if (task) form.querySelector('#b-task').value = task;
      form.scrollIntoView({ behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth', block: 'center' });
      form.classList.remove('is-pinged');
      void form.offsetWidth;
      form.classList.add('is-pinged');
      setTimeout(() => form.querySelector(id && !task ? '#b-task' : '#b-model').focus({ preventScroll: true }), 650);
    });
  })();
</script>

<style>
  .booking {
    position: relative;
    display: grid;
    gap: 20px;
    padding: clamp(20px, 2.4vw, 32px);
    background: rgb(5 15 34 / 0.72);
    -webkit-backdrop-filter: blur(20px) saturate(130%);
    backdrop-filter: blur(20px) saturate(130%);
    border-radius: var(--radius);
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.12),
      0 30px 60px -20px rgb(0 0 0 / 0.5);
    color: var(--white);
  }

  /* the top edge is a light-line: lit when the configurator is called */
  .booking::before {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    height: 2px;
    background: linear-gradient(90deg, transparent, var(--light) 20%, #fff 50%, var(--light) 80%, transparent);
    box-shadow: 0 0 14px 1px rgb(var(--light-glow) / 0.7);
    opacity: 0.55;
    transform-origin: center;
  }

  .booking:global(.is-pinged)::before {
    animation: ping 1.2s var(--ease-out);
  }

  @keyframes ping {
    0% {
      transform: scaleX(0);
      opacity: 1;
    }
    60% {
      transform: scaleX(1);
      opacity: 1;
    }
    100% {
      opacity: 0.55;
    }
  }

  fieldset {
    border: 0;
    margin: 0;
    padding: 0;
    min-width: 0;
  }

  .booking__label {
    display: block;
    margin-bottom: 8px;
    padding: 0;
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--blue-200);
  }

  .seg {
    display: flex;
    flex-wrap: wrap;
    gap: 1px;
    background: rgb(255 255 255 / 0.12);
    border-radius: var(--radius);
    padding: 1px;
  }

  .seg__item {
    position: relative;
    flex: 1 1 auto;
    cursor: pointer;
  }

  .seg__item input {
    position: absolute;
    opacity: 0;
    inset: 0;
    margin: 0;
    cursor: pointer;
  }

  .seg__item span {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    min-height: 48px;
    padding: 0 16px;
    background: var(--blue-950);
    font-weight: 500;
    font-size: 0.9375rem;
    white-space: nowrap;
    transition:
      background-color 0.3s var(--ease-out),
      color 0.3s var(--ease-out),
      box-shadow 0.3s var(--ease-out);
  }

  .seg__item:hover span {
    background: var(--blue-850);
  }

  .seg__item input:checked + span {
    background: var(--white);
    color: var(--blue-900);
  }

  .seg__item input:focus-visible + span {
    outline: 2px solid var(--light);
    outline-offset: -4px;
  }

  .booking__row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr) auto auto;
    gap: 16px;
    align-items: end;
  }

  .field input {
    width: 100%;
    min-height: 50px;
    padding: 0 16px;
    border: 0;
    border-radius: var(--radius);
    background: rgb(255 255 255 / 0.06);
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.16);
    color: var(--white);
    transition:
      box-shadow 0.3s var(--ease-out),
      background-color 0.3s var(--ease-out);
  }

  .field input::placeholder {
    color: rgb(201 216 239 / 0.72);
  }

  .field input:hover {
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.32);
  }

  .field input:focus {
    outline: none;
    background: rgb(255 255 255 / 0.1);
    box-shadow:
      inset 0 0 0 1px var(--light),
      0 0 0 3px rgb(var(--light-glow) / 0.18);
  }

  .seg--icons .seg__item span {
    padding: 0 14px;
    min-height: 50px;
  }

  .booking__submit {
    min-height: 52px;
  }

  .booking__status {
    font-size: 0.875rem;
    color: var(--blue-200);
    min-height: 1.6em;
  }

  .booking__status a {
    color: var(--white);
    font-weight: 600;
  }

  .booking__status[data-kind='error'] {
    color: #ffb3b5;
  }

  .booking__status[data-kind='ok'] {
    color: #a9f3c4;
  }

  @media (max-width: 1180px) {
    .booking__row {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 640px) {
    .booking__row {
      grid-template-columns: 1fr;
    }

    .seg__item span {
      min-height: 44px;
      padding: 0 12px;
      font-size: 0.875rem;
    }

    .seg--icons .seg__item span {
      padding: 0 8px;
    }

    .booking__submit {
      width: 100%;
    }
  }
</style>

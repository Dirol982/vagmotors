---
import { Image } from 'astro:assets';
import logoLight from '../assets/logo-light.png';
import Icon from './Icon.astro';
import OpenSign from './OpenSign.astro';
import { site, nav } from '../data/site';

interface Props {
  home?: boolean;
}
const { home = true } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const href = (h: string) => (h.startsWith('#') ? (home ? h : `${base}${h}`) : `${base}${h}`);
---

<header class="site-header on-blue" data-header>
  <div class="site-header__bar wrap">
    <a class="site-header__logo" href={base} aria-label="VAGMOTORS — на главную">
      <Image src={logoLight} alt="" width={120} height={49} loading="eager" />
    </a>

    <nav class="site-header__nav" aria-label="Основная навигация">
      <ul>
        {nav.map((n) => (
          <li>
            <a href={href(n.href)}>{n.label}</a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="site-header__aside">
      <a class="site-header__phone num" href={`tel:${site.service.tel}`}>{site.service.label}</a>
      <a class="btn site-header__cta" href={href('#book')} data-book-link>Записаться</a>
      <button class="site-header__burger" type="button" aria-expanded="false" aria-controls="mobile-menu" data-menu-toggle>
        <span class="sr-only">Меню</span>
        <Icon name="menu" size={26} class="i-open" />
        <Icon name="close" size={26} class="i-close" />
      </button>
    </div>
  </div>

  <div class="mobile-menu" id="mobile-menu" data-menu hidden>
    <nav aria-label="Мобильная навигация">
      <ul>
        {nav.map((n, i) => (
          <li style={`--i:${i}`}>
            <a href={href(n.href)} data-menu-link>
              {n.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
    <div class="mobile-menu__foot">
      <OpenSign />
      <a class="mobile-menu__phone num" href={`tel:${site.service.tel}`}>{site.service.label}</a>
      <p class="muted">{site.city}, {site.addressShort}</p>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 50;
    background: transparent;
    transition:
      background-color 0.5s var(--ease-out),
      box-shadow 0.5s var(--ease-out),
      transform 0.5s var(--ease-out);
  }

  .site-header.is-scrolled {
    background: rgb(10 27 56 / 0.82);
    -webkit-backdrop-filter: saturate(140%) blur(16px);
    backdrop-filter: saturate(140%) blur(16px);
    box-shadow: 0 1px 0 rgb(255 255 255 / 0.08);
  }

  /* a backdrop-filter would trap the fixed menu inside the bar */
  .site-header:has([data-menu-toggle][aria-expanded='true']) {
    background: var(--blue-900);
    -webkit-backdrop-filter: none;
    backdrop-filter: none;
  }

  .site-header.is-hidden {
    transform: translateY(-100%);
  }

  .site-header__bar {
    display: flex;
    align-items: center;
    gap: 32px;
    height: 80px;
  }

  .site-header__logo {
    flex: none;
    display: block;
  }

  .site-header__logo img {
    width: 104px;
    height: auto;
  }

  .site-header__nav {
    flex: 1;
  }

  .site-header__nav ul {
    display: flex;
    gap: clamp(16px, 2vw, 32px);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .site-header__nav a {
    position: relative;
    display: block;
    padding: 8px 0;
    font-size: 0.9375rem;
    font-weight: 500;
    text-decoration: none;
    color: var(--blue-200);
    transition: color 0.3s var(--ease-out);
  }

  .site-header__nav a::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 2px;
    height: 1px;
    background: var(--light);
    box-shadow: 0 0 8px rgb(var(--light-glow) / 0.8);
    transform: scaleX(0);
    transform-origin: right;
    transition: transform 0.5s var(--ease-out);
  }

  .site-header__nav a:hover {
    color: var(--white);
  }

  .site-header__nav a:hover::after {
    transform: scaleX(1);
    transform-origin: left;
  }

  .site-header__aside {
    display: flex;
    align-items: center;
    gap: 24px;
    margin-left: auto;
  }

  .site-header__sign {
    color: var(--blue-200);
  }

  .site-header__phone {
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
  }

  .site-header__cta {
    min-height: 44px;
    padding: 0 20px;
    font-size: 0.9375rem;
  }

  .site-header__burger {
    display: none;
    width: 44px;
    height: 44px;
    align-items: center;
    justify-content: center;
    border: 0;
    background: transparent;
    color: var(--white);
    cursor: pointer;
  }

  .site-header__burger :global(.i-close) {
    display: none;
  }

  .site-header__burger[aria-expanded='true'] :global(.i-open) {
    display: none;
  }

  .site-header__burger[aria-expanded='true'] :global(.i-close) {
    display: block;
  }

  .mobile-menu {
    position: fixed;
    inset: 72px 0 0 0;
    background: var(--blue-900);
    padding: 24px var(--gutter) 40px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    overflow-y: auto;
  }

  .mobile-menu[hidden] {
    display: none;
  }

  .mobile-menu ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .mobile-menu li {
    border-bottom: 1px solid rgb(255 255 255 / 0.1);
    animation: menu-in 0.6s var(--ease-out) both;
    animation-delay: calc(var(--i) * 45ms);
  }

  .mobile-menu a {
    display: block;
    padding: 16px 0;
    font-family: var(--font-display);
    font-size: 2rem;
    font-weight: 500;
    letter-spacing: -0.03em;
    text-decoration: none;
  }

  .mobile-menu__foot {
    display: grid;
    gap: 12px;
    padding-top: 32px;
    color: var(--blue-200);
  }

  .mobile-menu__phone {
    font-family: var(--font-display);
    font-size: 1.75rem;
    font-weight: 600;
    color: var(--white);
    text-decoration: none;
  }

  @keyframes menu-in {
    from {
      opacity: 0;
      transform: translateY(16px);
    }
  }

  @media (max-width: 1240px) {
    .site-header__sign {
      display: none;
    }
  }

  @media (max-width: 1080px) {
    .site-header__nav {
      display: none;
    }

    .site-header__burger {
      display: inline-flex;
    }
  }

  @media (max-width: 640px) {
    .site-header__bar {
      height: 72px;
      gap: 16px;
    }

    .site-header__logo img {
      width: 88px;
    }

    .site-header__phone,
    .site-header__cta {
      display: none;
    }
  }
</style>

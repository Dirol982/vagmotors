---
interface Props {
  name:
    | 'phone'
    | 'telegram'
    | 'viber'
    | 'whatsapp'
    | 'arrow'
    | 'arrow-up-right'
    | 'arrow-left'
    | 'pin'
    | 'clock'
    | 'mail'
    | 'menu'
    | 'close'
    | 'instagram'
    | 'vk'
    | 'facebook'
    | 'ok'
    | 'plus'
    | 'search';
  size?: number;
  class?: string;
  label?: string;
}
const { name, size = 20, class: cls, label } = Astro.props;
const a11y = label ? { role: 'img', 'aria-label': label } : { 'aria-hidden': 'true' };
---

<svg
  class={cls}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  {...a11y}
>
  {name === 'phone' && (
    <path d="M5.2 3.5h3l1.6 4.2-2 1.4a11 11 0 0 0 7.1 7.1l1.4-2 4.2 1.6v3a1.7 1.7 0 0 1-1.8 1.7C10.6 20 4 13.4 3.5 5.3a1.7 1.7 0 0 1 1.7-1.8Z" />
  )}
  {name === 'telegram' && (
    <>
      <path d="M21 4 3 11.2l5.6 2L17.5 7l-6.8 7.6.2 5.4 3-3.6 4.3 3.1L21 4Z" />
    </>
  )}
  {name === 'viber' && (
    <>
      <path d="M12 2.8c-5 0-8.4 1.4-8.4 7.6 0 3.6 1 5.6 3.3 6.7v3.6l3-2.9c.7.1 1.4.1 2.1.1 5 0 8.4-1.4 8.4-7.5S17 2.8 12 2.8Z" />
      <path d="M9.4 7.6c.4 0 .9.9 1.1 1.4.2.4-.6 1-.6 1.2.5 1.3 1.5 2.3 2.8 2.8.2 0 .8-.8 1.2-.6.5.2 1.4.7 1.4 1.1 0 .6-.6 1.3-1.3 1.3-2.8-.3-5.6-3.1-5.9-5.9 0-.7.7-1.3 1.3-1.3Z" />
    </>
  )}
  {name === 'whatsapp' && (
    <>
      <path d="M4 20.2 5.2 16A8.6 8.6 0 1 1 8 18.8l-4 1.4Z" />
      <path d="M9.2 8c.3 0 .7.8.9 1.2.2.4-.5.9-.5 1.1.4 1.1 1.3 2 2.4 2.4.2 0 .7-.7 1-.5.4.2 1.2.6 1.2.9 0 .5-.5 1.1-1.1 1.1-2.4-.2-4.7-2.5-5-4.9 0-.6.6-1.3 1.1-1.3Z" />
    </>
  )}
  {name === 'arrow' && <path d="M4 12h16m-6-6 6 6-6 6" />}
  {name === 'arrow-left' && <path d="M20 12H4m6-6-6 6 6 6" />}
  {name === 'arrow-up-right' && <path d="M7 17 17 7M8 7h9v9" />}
  {name === 'pin' && (
    <>
      <path d="M12 21s-7-6.2-7-11.5a7 7 0 1 1 14 0C19 14.8 12 21 12 21Z" />
      <circle cx="12" cy="9.5" r="2.5" />
    </>
  )}
  {name === 'clock' && (
    <>
      <circle cx="12" cy="12" r="8.5" />
      <path d="M12 7.5V12l3 2" />
    </>
  )}
  {name === 'mail' && (
    <>
      <rect x="3" y="5" width="18" height="14" rx="1.5" />
      <path d="m3.5 6 8.5 7 8.5-7" />
    </>
  )}
  {name === 'menu' && <path d="M3 8h18M3 16h18" />}
  {name === 'close' && <path d="M5 5l14 14M19 5 5 19" />}
  {name === 'plus' && <path d="M12 5v14M5 12h14" />}
  {name === 'search' && (
    <>
      <circle cx="11" cy="11" r="6.5" />
      <path d="m20 20-4.4-4.4" />
    </>
  )}
  {name === 'instagram' && (
    <>
      <rect x="3.5" y="3.5" width="17" height="17" rx="4.5" />
      <circle cx="12" cy="12" r="4" />
      <circle cx="17.2" cy="6.8" r=".6" fill="currentColor" />
    </>
  )}
  {name === 'vk' && (
    <path d="M3 7h3.2c.3 3.4 1.8 5.4 3.3 5.8V7h3v3.4c1.5-.2 3-1.8 3.6-3.4h3c-.5 2.3-2 4.1-3.2 4.8 1.2.6 3.1 2.1 3.8 4.7h-3.3c-.6-1.7-2-3-3.9-3.2v3.2h-.4C6.7 16.5 3.3 13 3 7Z" />
  )}
  {name === 'facebook' && (
    <path d="M14 21v-7.5h2.6l.4-3H14V8.7c0-.9.3-1.5 1.5-1.5H17V4.5a19 19 0 0 0-2.3-.1c-2.3 0-3.8 1.4-3.8 3.9v2.2H8.3v3h2.6V21" />
  )}
  {name === 'ok' && (
    <>
      <circle cx="12" cy="7.5" r="3.8" />
      <path d="M7.5 13.5c2.8 1.8 6.2 1.8 9 0M12 15.5l-4 4.5m4-4.5 4 4.5" />
    </>
  )}
</svg>

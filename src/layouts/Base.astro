---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Icon from '../components/Icon.astro';
import { site } from '../data/site';

interface Props {
  title: string;
  description: string;
  home?: boolean;
}
const { title, description, home = true } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const canonical = new URL(Astro.url.pathname, Astro.site);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'AutoRepair',
  name: 'VAGMOTORS',
  legalName: site.legalName,
  url: 'https://vagmotors.by/',
  telephone: site.service.tel,
  email: site.email,
  address: {
    '@type': 'PostalAddress',
    streetAddress: site.address,
    addressLocality: 'Минск',
    postalCode: '220037',
    addressCountry: 'BY',
  },
  geo: { '@type': 'GeoCoordinates', latitude: site.geo.lat, longitude: site.geo.lng },
  openingHours: 'Mo-Su 09:00-21:00',
  sameAs: Object.values(site.social),
};
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="format-detection" content="telephone=no" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#0a1b38" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="ru_RU" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <link rel="icon" type="image/png" href={`${base}favicon.png`} />
    <link rel="apple-touch-icon" href={`${base}apple-touch-icon.png`} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <script is:inline>
      if (!matchMedia('(prefers-reduced-motion: reduce)').matches) document.documentElement.classList.add('js-motion');
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">К содержанию</a>
    <Header home={home} />
    <main id="main">
      <slot />
    </main>
    <Footer home={home} />

    <nav class="dock on-blue" aria-label="Быстрая связь">
      <a href={`tel:${site.service.tel}`} class="dock__call"><Icon name="phone" /> Позвонить</a>
      {home ? (
        <button type="button" class="dock__book" data-check-open aria-controls="precheck">
          <span data-dock-label>Предчек</span> <span class="dock__sum num" data-dock-sum>пусто</span>
        </button>
      ) : (
        <a href={`${base}#calc`} class="dock__book">Калькулятор <Icon name="arrow" /></a>
      )}
    </nav>

    <script>
      import '../scripts/motion.ts';
      const sum = document.querySelector<HTMLElement>('[data-dock-sum]');
      const fmt = new Intl.NumberFormat('ru-RU');
      document.addEventListener('precheck:change', (e) => {
        const { count, total } = (e as CustomEvent<{ count: number; total: number }>).detail;
        if (sum) sum.textContent = count ? `${count} · от ${fmt.format(total)} руб.` : 'пусто';
      });
    </script>
  </body>
</html>

<style>
  .dock {
    position: fixed;
    left: 12px;
    right: 12px;
    bottom: calc(12px + env(safe-area-inset-bottom));
    z-index: 40;
    display: none;
    grid-template-columns: 1fr 1.3fr;
    gap: 1px;
    padding: 1px;
    border-radius: var(--radius);
    background: rgb(255 255 255 / 0.14);
    box-shadow: 0 16px 40px -12px rgb(5 15 34 / 0.55);
    transform: translateY(calc(100% + 24px));
    transition: transform 0.6s var(--ease-out);
  }

  .dock:global(.is-shown) {
    transform: none;
  }

  /* on phones the call and pre-check stay pinned */
  @media (max-width: 760px) {
    .dock {
      transform: none;
    }
    :global(body) {
      padding-bottom: calc(76px + env(safe-area-inset-bottom));
    }
  }

  .dock a,
  .dock button {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    min-height: 52px;
    font-weight: 600;
    text-decoration: none;
    border: 0;
    color: var(--white);
    font-size: 1rem;
    cursor: pointer;
  }

  .dock__sum {
    font-weight: 500;
    font-size: 0.875rem;
    opacity: 0.85;
  }

  .dock__call {
    background: var(--blue-900);
  }

  .dock__book {
    background: var(--red);
  }

  @media (max-width: 760px) {
    .dock {
      display: grid;
    }
  }
</style>

---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import BookingForm from '../components/BookingForm.astro';
import Calculator from '../components/Calculator.astro';
import Icon from '../components/Icon.astro';
import OpenSign from '../components/OpenSign.astro';
import { site, makes } from '../data/site';
import { reviews } from '../data/reviews';
import prices from '../data/prices.json';

import hall from '../assets/photos/audi-a3-hall.jpg';
import s6 from '../assets/photos/audi-s6-lift.jpg';
import engineBay from '../assets/photos/vw-engine-bay.jpg';
import macan from '../assets/photos/porsche-macan.jpg';
import cayenne from '../assets/photos/cayenne-lift.jpg';
import cams from '../assets/photos/camshafts.jpg';
import skodaDiag from '../assets/photos/skoda-diagnostics.jpg';
import oilService from '../assets/photos/vw-oil-service.jpg';
import golf from '../assets/photos/golf-gti-lift.jpg';
import oilShelf from '../assets/photos/vw-oil-shelf.jpg';
import vas from '../assets/photos/vas-6150d.jpg';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');

/* Lowest "from" price per category across the published price lists */
const minBy = new Map<string, number>();
for (const brand of prices) {
  for (const cat of brand.cats) {
    for (const it of cat.items) {
      if (!it.price) continue;
      const cur = minBy.get(cat.name);
      if (cur === undefined || it.price < cur) minBy.set(cat.name, it.price);
    }
  }
}
const from = (name: string) => minBy.get(name);

const services = [
  { cat: 'Диагностика', note: 'Компьютерная, двигателя, подвески, перед покупкой. Дилерское ПО.', img: 'diag', task: 'Компьютерная диагностика' },
  { cat: 'Техническое обслуживание', note: 'ТО по регламенту завода: масла, фильтры, свечи, ремень и цепь ГРМ.', img: 'oil', task: 'Плановое ТО' },
  { cat: 'Ремонт КПП', note: 'DSG, S tronic, АКПП, вариатор, МКПП. Сцепление и маховик.', img: 's6', task: 'Диагностика и ремонт DSG' },
  { cat: 'Ремонт двигателя', note: 'От форсунок и турбины до масложора и капитального ремонта.', img: 'cams', task: 'Ремонт двигателя' },
  { cat: 'Ремонт подвески', note: 'Амортизаторы, рычаги, сайлентблоки, пневмоподвеска.', img: 'cayenne', task: 'Ремонт подвески' },
  { cat: 'Ремонт тормозов', note: 'Колодки, диски, суппорты, стояночный тормоз, жидкость.', img: 'golf', task: 'Ремонт тормозов' },
  { cat: 'Электрика', note: 'Генератор, стартер, проводка, АБС, стеклоподъёмники.', img: 'vas', task: 'Электрика' },
  { cat: 'Ремонт системы охлаждения', note: 'Помпа, термостат, радиатор, поиск утечек антифриза.', img: 'bay', task: 'Ремонт системы охлаждения' },
  { cat: 'Ремонт рулевого управления', note: 'Рейка, тяги, наконечники, усилитель руля.', img: 'macan', task: 'Ремонт рулевого управления' },
  { cat: 'Ремонт отопителя и кондиционера', note: 'Диагностика, заправка и ремонт климатической системы.', img: 'hall', task: 'Кондиционер и отопитель' },
];
const peekImgs = { diag: skodaDiag, oil: oilService, s6, cams, cayenne, golf, vas, bay: engineBay, macan, hall };

const gallery = [
  { img: hall, cap: 'Цех на 1-м Твёрдом переулке', alt: 'Audi A3 и Volkswagen Caddy в светлом цеху VAGMOTORS' },
  { img: vas, cap: 'VAS 6150D — дилерский диагностический комплекс', alt: 'Диагностический ноутбук VAS 6150D на столе мастера' },
  { img: cams, cap: 'Распредвалы и цепь ГРМ под контролем', alt: 'Открытая головка блока цилиндров с распредвалами' },
  { img: macan, cap: 'Porsche Macan в работе', alt: 'Porsche Macan в цеху' },
  { img: oilService, cap: 'Оригинальное масло Volkswagen', alt: 'Мастер заливает оригинальное масло Volkswagen в двигатель' },
  { img: golf, cap: 'Golf GTI на подъёмнике', alt: 'Белый Volkswagen Golf GTI на подъёмнике' },
  { img: skodaDiag, cap: 'Компьютерная диагностика Škoda', alt: 'Ноутбук с диагностикой в салоне Škoda' },
  { img: engineBay, cap: 'Разборка моторного отсека', alt: 'Разобранный передок Volkswagen с открытым моторным отсеком' },
  { img: cayenne, cap: 'Porsche Cayenne: ходовая', alt: 'Porsche Cayenne на подъёмнике' },
  { img: oilShelf, cap: 'Запчасти и жидкости на складе', alt: 'Канистры с оригинальным маслом на складском стеллаже' },
];

const warranty = [
  { km: 2000, months: 1, title: 'Техническое обслуживание и регулировочно-наладочные работы' },
  { km: 10000, months: 6, title: 'Ремонт с нашими лицензионными запасными частями' },
  { km: 20000, months: 12, title: 'Ремонт с нашими оригинальными запасными частями' },
];
const monthWord = (n: number) => (n === 1 ? 'месяц' : n < 5 ? 'месяца' : 'месяцев');
const fmt = new Intl.NumberFormat('ru-RU');
---

<Base
  title="VAGMOTORS — сервис Volkswagen, Audi, Škoda, SEAT, Porsche в центре Минска"
  description="Специализированный сервисный центр концерна VAG в центре Минска: диагностика, ТО, ремонт DSG, двигателя и подвески. Гарантия до 12 месяцев. Ежедневно 9:00–21:00. +375 29 620-04-21"
>
  <!-- ═══ First viewport ═══ -->
  <section class="hero on-blue" data-hero aria-labelledby="hero-title">
    <div class="hero__media" aria-hidden="true">
      <Image src={hall} alt="" widths={[640, 960, 1440, 1920]} sizes="(max-width: 900px) 100vw, 62vw" loading="eager" fetchpriority="high" />
    </div>

    <div class="hero__ceiling" aria-hidden="true">
      <span class="lightline" style="--i:0; --w:62%; --x:30%; --y:0%"></span>
      <span class="lightline" style="--i:1; --w:48%; --x:44%; --y:34%"></span>
      <span class="lightline" style="--i:2; --w:36%; --x:56%; --y:60%"></span>
      <span class="lightline" style="--i:3; --w:26%; --x:64%; --y:80%"></span>
    </div>

    <div class="wrap hero__inner">
      <div class="hero__copy">
        <p class="hero__where"><OpenSign /> <span class="hero__dot" aria-hidden="true"></span> {site.city}, {site.addressShort}</p>
        <h1 class="h-display" id="hero-title">
          <span class="hero__line"><span>Специалисты</span></span>
          <span class="hero__line"><span>по автомобилям</span></span>
          <span class="hero__line"><span>концерна <em>VAG</em></span></span>
        </h1>
        <p class="lede hero__lede">
          Volkswagen, Audi, Škoda, SEAT, Porsche и Bentley — от замены лампочки до капитального ремонта двигателя.
          Технология завода, гарантия до 12&nbsp;месяцев.
        </p>
        <a class="link-arrow hero__calc" href="#calc">Рассчитать стоимость работ <Icon name="arrow" /></a>
      </div>
      <div class="hero__book">
        <BookingForm />
      </div>
    </div>
  </section>

  <!-- ═══ Makes, billed by size ═══ -->
  <section class="makes section" aria-labelledby="makes-title">
    <div class="wrap">
      <div class="makes__head">
        <h2 class="h-section" id="makes-title" data-reveal>Один концерн.<br />Шесть марок.</h2>
        <p class="lede muted" data-reveal style="--d:1">
          Мы работаем по технологии завода-производителя и знаем слабые места каждой модификации. Выберите марку —
          и мы подставим её в заявку.
        </p>
      </div>

      <ul class="lineup" role="list">
        {makes.map((m, i) => (
          <li class={`lineup__item tier-${m.tier}`} data-reveal style={`--d:${i}`}>
            <a href="#book" data-pick-make={m.id}>
              <span class="lineup__name">{m.name}</span>
              <span class="lineup__go">
                Записать {m.name} <Icon name="arrow-up-right" size={18} />
              </span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ═══ Services index ═══ -->
  <section class="services section" id="services" aria-labelledby="services-title">
    <div class="wrap">
      <div class="services__head">
        <h2 class="h-section" id="services-title" data-reveal>От лампочки<br />до капремонта</h2>
        <div class="services__aside" data-reveal style="--d:1">
          <p class="muted">
            Стоимость зависит от модели, двигателя и коробки, поэтому указана от минимальной. Точную цену назовём по
            марке, модели, году и VIN.
          </p>
          <a class="link-arrow" href={`${base}price/`}>Полный прайс-лист <Icon name="arrow" /></a>
        </div>
      </div>

      <div class="index" data-index>
        <ol class="index__list" role="list">
          {services.map((s) => (
            <li class="index__row" data-peek-src={s.img} data-reveal>
              <a href="#book" data-pick-task={s.task}>
                <span class="index__name">{s.cat.replace('Ремонт ', 'Ремонт ')}</span>
                <span class="index__note">{s.note}</span>
                <span class="index__price num">
                  {from(s.cat) !== undefined ? (
                    <>
                      <small>от</small>{' '}{fmt.format(from(s.cat)!)}{'\u00a0'}<small>руб.</small>
                    </>
                  ) : (
                    <small>по запросу</small>
                  )}
                </span>
                <span class="index__go" aria-hidden="true">
                  <Icon name="arrow" />
                </span>
              </a>
            </li>
          ))}
        </ol>
        <div class="index__peek" data-peek aria-hidden="true">
          {Object.entries(peekImgs).map(([id, img]) => (
            <Image src={img} alt="" width={360} height={480} data-peek-img={id} loading="lazy" />
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- ═══ Calculator ═══ -->
  <Calculator />

  <!-- ═══ DSG ═══ -->
  <section class="dsg section on-blue-deep" id="dsg" aria-labelledby="dsg-title">
    <span class="lightline seam" aria-hidden="true" data-reveal="line"></span>
    <div class="dsg__series" aria-hidden="true">
      <div class="dsg__track" data-drift="1">DQ200 · DQ250 · DQ500 · DL501 · DL382 · DQ200 · DQ250</div>
    </div>

    <div class="wrap dsg__grid">
      <div class="dsg__lead">
        <h2 class="h-section" id="dsg-title" data-reveal>Ремонт DSG<br />без «дешёвых решений»</h2>
        <p class="lede muted" data-reveal style="--d:1">
          Коробка DSG требует не только оборудования, но и знания нюансов каждой серии. Мы делаем технологически
          правильный ремонт, который возвращает трансмиссии заводской ресурс.
        </p>
        <div class="dsg__cta" data-reveal style="--d:2">
          <a class="btn" href="#book" data-pick-task="Диагностика и ремонт DSG">Записаться на диагностику DSG <Icon name="arrow" /></a>
          <p class="muted num">Диагностика DSG — от 50&nbsp;руб.</p>
        </div>
      </div>

      <figure class="dsg__photo" data-reveal="image">
        <Image src={s6} alt="Audi S6 на территории сервиса, на фоне — внедорожник на подъёмнике" widths={[480, 800, 1100]} sizes="(max-width: 900px) 100vw, 40vw" />
      </figure>

      <div class="dsg__cols">
        <div>
          <h3 class="dsg__h">Что делаем</h3>
          <dl class="spec">
            <div data-reveal><dt>Диагностика</dt><dd>Компьютерная и механическая: параметры работы, давление в гидросистеме, состояние пакетов сцепления.</dd></div>
            <div data-reveal style="--d:1"><dt>Мехатроник</dt><dd>Ремонт и прошивка: замена плат, ремонт гидравлической части, устранение ошибок по давлению.</dd></div>
            <div data-reveal style="--d:2"><dt>Сцепление</dt><dd>Замена комплекта со специнструментом для регулировки зазоров — это критично для ресурса узла.</dd></div>
            <div data-reveal style="--d:3"><dt>Маховик</dt><dd>Замена двухмассового маховика: устраняем посторонние шумы и вибрации.</dd></div>
          </dl>
        </div>
        <div>
          <h3 class="dsg__h">Когда пора к нам</h3>
          <ul class="symptoms" role="list">
            <li data-reveal>Рывки и толчки при переключении, особенно 1–2</li>
            <li data-reveal style="--d:1">Вибрации при начале движения</li>
            <li data-reveal style="--d:2">Коробка уходит в аварийный режим</li>
            <li data-reveal style="--d:3">Пропали чётные или нечётные передачи</li>
            <li data-reveal style="--d:4">Лязг или скрежет при работе трансмиссии</li>
          </ul>
          <p class="dsg__warn muted">Не откладывайте ремонт: неисправность одного узла DSG быстро выводит из строя другие.</p>
        </div>
      </div>

      <ul class="dsg__facts" role="list">
        <li>Дилерское ПО и специнструмент для настройки DSG</li>
        <li>Оригинальные детали и проверенные LUK, Sachs</li>
        <li>Официальная гарантия на работу и установленные детали</li>
      </ul>
    </div>
  </section>

  <!-- ═══ Warranty in kilometres ═══ -->
  <section class="warranty section" id="warranty" aria-labelledby="warranty-title">
    <div class="wrap">
      <div class="warranty__head">
        <h2 class="h-section" id="warranty-title" data-reveal>Гарантия,<br />измеренная в километрах</h2>
        <p class="lede muted" data-reveal style="--d:1">Действует на все работы и запчасти, установленные на нашей станции — по тому сроку, что наступит раньше.</p>
      </div>

      <div class="odo" role="list">
        <div class="odo__scale" aria-hidden="true">
          {[0, 5000, 10000, 15000, 20000].map((k) => (
            <span class="num" style={`--at:${k / 20000}`}>{fmt.format(k)}</span>
          ))}
        </div>
        {warranty.map((w, i) => (
          <div class="odo__row" role="listitem" data-reveal style={`--d:${i}`}>
            <div class="odo__figure">
              <span class="odo__km num"><span data-count={w.km}>{fmt.format(w.km)}</span>&nbsp;км</span>
              <span class="odo__mo">или {w.months} {monthWord(w.months)}</span>
            </div>
            <p class="odo__title">{w.title}</p>
            <div class="odo__track" aria-hidden="true">
              <span class="odo__fill" data-gauge={w.km / 20000} style={`--g:${w.km / 20000}`}></span>
            </div>
          </div>
        ))}
      </div>
      <p class="warranty__note muted">
        Ремонт с запчастями клиента — гарантия только на работу: 1&nbsp;месяц или 2&nbsp;000&nbsp;км пробега.
      </p>
    </div>
  </section>

  <!-- ═══ Workshop rail ═══ -->
  <section class="workshop on-blue" id="workshop" aria-labelledby="workshop-title">
    <span class="lightline seam" aria-hidden="true" data-reveal="line"></span>
    <div class="rail" data-rail>
      <div class="rail__sticky">
        <div class="rail__track" data-rail-track>
          <div class="rail__intro">
            <h2 class="h-section" id="workshop-title">Наш цех</h2>
            <p class="lede muted">
              Чистая мастерская, подъёмники, дилерская диагностика. За ремонтом можно наблюдать — мы постоянно
              держим вас в курсе и согласовываем каждое действие.
            </p>
            <span class="rail__hint muted" aria-hidden="true">Листайте <Icon name="arrow" size={18} /></span>
          </div>
          {gallery.map((g, i) => (
            <figure class={`rail__item ${i % 3 === 1 ? 'is-tall' : ''}`}>
              <div class="rail__frame">
                <Image src={g.img} alt={g.alt} widths={[400, 640, 900]} sizes="(max-width: 900px) 78vw, 30vw" loading="lazy" />
              </div>
              <figcaption>{g.cap}</figcaption>
            </figure>
          ))}
        </div>
        <div class="rail__progress" aria-hidden="true"><span></span></div>
      </div>
    </div>
  </section>

  <!-- ═══ About + comfort ═══ -->
  <section class="about section" aria-labelledby="about-title">
    <div class="wrap about__grid">
      <div class="about__text">
        <h2 class="h-section" id="about-title" data-reveal>Вы всегда знаете, что с вашей машиной</h2>
        <p data-reveal style="--d:1">
          VAGMOTORS — специализированный сервисный центр Volkswagen, Audi, Škoda, SEAT, Porsche и Bentley. Полный
          спектр услуг: от замены лампочки до капитального ремонта двигателя.
        </p>
        <p data-reveal style="--d:2">
          Мы постоянно информируем о ходе работ и согласовываем действия с вами. Ставим оригинальные и лицензионные
          запчасти только от проверенных поставщиков и официальных импортёров — и даём гарантию на всё, что сделали.
        </p>
        <p class="about__limit" data-reveal style="--d:3">Работаем с автомобилями не старше 2006 года выпуска.</p>
      </div>

      <dl class="comfort">
        <div data-reveal><dt>Центр Минска</dt><dd>{site.addressShort}</dd></div>
        <div data-reveal style="--d:1"><dt>Без выходных</dt><dd class="num">Ежедневно 9:00–21:00</dd></div>
        <div data-reveal style="--d:2"><dt>Оригинальные запчасти</dt><dd>Купить и установить у нас</dd></div>
        <div data-reveal style="--d:3"><dt>Эвакуатор</dt><dd>Предоставляем</dd></div>
        <div data-reveal style="--d:4"><dt>Зона ожидания</dt><dd>Бесплатный кофе и Wi‑Fi</dd></div>
      </dl>

      <aside class="parts" data-reveal>
        <h3>Оригинальные запчасти Volkswagen, Audi, Škoda, SEAT и Porsche</h3>
        <p class="muted">Продаём только с последующей установкой на нашем сервисе.</p>
        <div class="parts__actions">
          <a class="btn btn--blue" href={`tel:${site.parts.tel}`}><Icon name="phone" /> <span class="num">{site.parts.label}</span></a>
          <a class="link-arrow" href={site.messengers.viberParts}>Написать в Viber <Icon name="arrow" /></a>
        </div>
      </aside>
    </div>
  </section>

  <!-- ═══ Reviews ═══ -->
  <section class="reviews section" id="reviews" aria-labelledby="reviews-title">
    <div class="wrap">
      <div class="reviews__head">
        <h2 class="h-section" id="reviews-title" data-reveal>Что говорят владельцы</h2>
        <p class="reviews__links" data-reveal style="--d:1">
          <span class="muted">Все отзывы:</span>
          <a href={site.reviewsLinks.yandex} target="_blank" rel="noopener">Яндекс Карты</a>
          <a href={site.reviewsLinks.google} target="_blank" rel="noopener">Google</a>
          <a href={site.reviewsLinks.vk} target="_blank" rel="noopener">ВКонтакте</a>
        </p>
      </div>

      <div class="quotes" data-quotes>
        <div class="quotes__stage">
          {reviews.map((r, i) => (
            <figure class={`quote ${i === 0 ? 'is-on' : ''}`} data-quote aria-hidden={i === 0 ? 'false' : 'true'}>
              <blockquote>
                <p>{r.text}</p>
              </blockquote>
              <figcaption>
                <strong>{r.name}</strong>
                <span class="muted">{r.car} · {r.date}</span>
              </figcaption>
            </figure>
          ))}
        </div>
        <div class="quotes__nav">
          <button type="button" class="quotes__btn" data-quote-prev aria-label="Предыдущий отзыв"><Icon name="arrow-left" /></button>
          <span class="num quotes__n" data-quote-n>01 / {String(reviews.length).padStart(2, '0')}</span>
          <button type="button" class="quotes__btn" data-quote-next aria-label="Следующий отзыв"><Icon name="arrow" /></button>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══ Business ═══ -->
  <section class="business section on-blue" id="business" aria-labelledby="business-title">
    <span class="lightline seam" aria-hidden="true" data-reveal="line"></span>
    <div class="wrap business__grid">
      <div>
        <h2 class="h-section" id="business-title" data-reveal>Для компаний<br />и автопарков</h2>
        <p class="lede muted" data-reveal style="--d:1">
          Обслуживаем как единичные автомобили, так и корпоративные парки. Если в парке есть машины не из концерна VAG —
          возьмём и их: у нас профессиональный сертификат на работу с большинством марок, представленных в Беларуси.
        </p>
      </div>
      <div class="business__side">
        <ul class="ticks" role="list">
          <li data-reveal>Наличный и безналичный расчёт</li>
          <li data-reveal style="--d:1">Работа с НДС</li>

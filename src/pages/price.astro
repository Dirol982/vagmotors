---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { site } from '../data/site';
import prices from '../data/prices.json';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const brandMeta: Record<string, { id: string; name: string; make: string }> = {
  'Цены на ремонт Фольксваген': { id: 'vw', name: 'Volkswagen', make: 'vw' },
  'Цены на ремонт Ауди': { id: 'audi', name: 'Audi', make: 'audi' },
  'Цены на ремонт Шкода': { id: 'skoda', name: 'Škoda', make: 'skoda' },
};

/* Merge categories that appear twice in the source list and drop duplicate rows */
const brands = Object.entries(brandMeta).map(([key, meta]) => {
  const src = prices.find((b) => b.brand.trim() === key);
  const cats = new Map<string, Map<string, number | undefined>>();
  for (const c of src?.cats ?? []) {
    const m = cats.get(c.name) ?? new Map();
    for (const it of c.items) if (!m.has(it.name)) m.set(it.name, it.price);
    cats.set(c.name, m);
  }
  return {
    ...meta,
    cats: Array.from(cats, ([name, items]) => ({
      name,
      slug: name.toLowerCase().replace(/[^a-zа-яё0-9]+/gi, '-'),
      items: Array.from(items, ([n, p]) => ({ name: n, price: p })).sort((a, b) => (a.price ?? 0) - (b.price ?? 0)),
    })),
  };
});
const fmt = new Intl.NumberFormat('ru-RU');
---

<Base
  title="Цены на ремонт Volkswagen, Audi, Škoda в Минске — VAGMOTORS"
  description="Стоимость работ VAGMOTORS: диагностика, ТО, ремонт DSG, двигателя, подвески и тормозов Volkswagen, Audi и Škoda. Цены от минимальных — точную стоимость назовём по VIN."
  home={false}
>
  <section class="ph on-blue">
    <span class="lightline ph__line" aria-hidden="true"></span>
    <div class="wrap ph__inner">
      <nav class="crumbs" aria-label="Навигационная цепочка"><a href={base}>Главная</a> <span aria-hidden="true">/</span> <span aria-current="page">Цены</span></nav>
      <h1 class="h-display">Стоимость работ</h1>
      <div class="ph__notes">
        <p class="lede">
          Цена одной и той же услуги сильно зависит от модели, двигателя, КПП и систем автомобиля, поэтому здесь указан
          минимум. Точную стоимость назовём по марке, модели, году, двигателю и VIN.
        </p>
        <div class="ph__ask">
          <a class="btn" href={site.messengers.viber}><Icon name="viber" /> Узнать цену в Viber</a>
          <a class="ph__tel num" href={`tel:${site.service.tel}`}>{site.service.label}</a>
        </div>
      </div>
    </div>
  </section>

  <section class="pl" data-pricelist>
    <div class="pl__bar">
      <div class="wrap pl__bar-inner">
        <div class="pl__tabs" role="tablist" aria-label="Марка">
          {brands.map((b, i) => (
            <button
              type="button"
              role="tab"
              id={`tab-${b.id}`}
              aria-controls={`panel-${b.id}`}
              aria-selected={i === 0 ? 'true' : 'false'}
              tabindex={i === 0 ? 0 : -1}
              data-tab={b.id}
            >
              {b.name}
            </button>
          ))}
        </div>
        <label class="pl__search">
          <Icon name="search" />
          <span class="sr-only">Поиск по услугам</span>
          <input type="search" placeholder="Найти услугу: сцепление, ГРМ, колодки…" data-search autocomplete="off" />
        </label>
      </div>
    </div>

    <div class="wrap">
      {brands.map((b, i) => (
        <div class="pl__panel" role="tabpanel" id={`panel-${b.id}`} aria-labelledby={`tab-${b.id}`} hidden={i !== 0} data-panel={b.id}>
          <nav class="pl__cats" aria-label={`Разделы прайса ${b.name}`}>
            <ul role="list">
              {b.cats.map((c) => (
                <li>
                  <a href={`#${b.id}-${c.slug}`}>{c.name}</a>
                </li>
              ))}
            </ul>
          </nav>
          <div class="pl__groups">
            {b.cats.map((c) => (
              <section class="pl__group" id={`${b.id}-${c.slug}`} data-group>
                <h2>{c.name}</h2>
                <table>
                  <caption class="sr-only">
                    {c.name}, {b.name}
                  </caption>
                  <thead class="sr-only">
                    <tr>
                      <th scope="col">Услуга</th>
                      <th scope="col">Цена от, руб.</th>
                    </tr>
                  </thead>
                  <tbody>
                    {c.items.map((it) => (
                      <tr data-row>
                        <th scope="row">{it.name}</th>
                        <td class="num">
                          {it.price ? (
                            <>
                              <small>от</small>{' '}{fmt.format(it.price)}{'\u00a0'}<small>руб.</small>
                            </>
                          ) : (
                            <small>по запросу</small>
                          )}
                        </td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </section>
            ))}
            <p class="pl__empty" data-empty hidden>
              Ничего не нашли. Напишите нам в <a href={site.messengers.viber}>Viber</a> или позвоните{' '}
              <a class="num" href={`tel:${site.service.tel}`}>{site.service.label}</a> — подскажем стоимость.
            </p>
          </div>
        </div>
      ))}

      <aside class="pl__more">
        <h2>Porsche, SEAT, Bentley</h2>
        <p class="muted">Стоимость работ по этим маркам назовём индивидуально — напишите модель, год и двигатель.</p>
        <a class="btn btn--blue" href={`${base}#book`}>Оставить заявку <Icon name="arrow" /></a>
      </aside>
    </div>
  </section>
</Base>

<script>
  const root = document.querySelector<HTMLElement>('[data-pricelist]');
  if (root) {
    const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-tab]'));
    const panels = Array.from(root.querySelectorAll<HTMLElement>('[data-panel]'));
    const search = root.querySelector<HTMLInputElement>('[data-search]');

    const select = (id: string, focus = false) => {
      tabs.forEach((t) => {
        const on = t.dataset.tab === id;
        t.setAttribute('aria-selected', String(on));
        t.tabIndex = on ? 0 : -1;
        if (on && focus) t.focus();
      });
      panels.forEach((p) => (p.hidden = p.dataset.panel !== id));
      filter();
    };

    tabs.forEach((t, i) => {
      t.addEventListener('click', () => select(t.dataset.tab!));
      t.addEventListener('keydown', (e) => {
        const d = e.key === 'ArrowRight' ? 1 : e.key === 'ArrowLeft' ? -1 : 0;
        if (!d) return;
        e.preventDefault();
        select(tabs[(i + d + tabs.length) % tabs.length].dataset.tab!, true);
      });
    });

    const filter = () => {
      const q = (search?.value || '').trim().toLowerCase();
      const panel = panels.find((p) => !p.hidden);
      if (!panel) return;
      let any = false;
      panel.querySelectorAll<HTMLElement>('[data-group]').forEach((g) => {
        let shown = 0;
        g.querySelectorAll<HTMLElement>('[data-row]').forEach((r) => {
          const hit = !q || r.textContent!.toLowerCase().includes(q);
          r.hidden = !hit;
          if (hit) shown++;
        });
        g.hidden = shown === 0;
        if (shown) any = true;
      });
      const empty = panel.querySelector<HTMLElement>('[data-empty]');
      if (empty) empty.hidden = any;
    };
    search?.addEventListener('input', filter);

    const fromHash = location.hash.slice(1).split('-')[0];
    if (tabs.some((t) => t.dataset.tab === fromHash)) select(fromHash);
  }
</script>

<style>
  .ph {
    position: relative;
    padding: clamp(150px, 18vw, 220px) 0 clamp(56px, 7vw, 96px);
    overflow: hidden;
  }

  .ph__line {
    position: absolute;
    top: 120px;
    left: 40%;
    width: 52%;
    opacity: 0.8;
    animation: line-on 1.4s var(--ease-out) 0.3s both;
  }

  @keyframes line-on {
    from {
      transform: scaleX(0);
      opacity: 0;
    }
  }

  .crumbs {
    display: flex;
    gap: 10px;
    font-size: 0.875rem;
    color: var(--blue-200);
    margin-bottom: 24px;
  }

  .crumbs a {
    color: var(--blue-200);
  }

  .ph__notes {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
    gap: 32px 64px;
    align-items: end;
    margin-top: 40px;
  }

  .ph__notes .lede {
    color: var(--blue-200);
  }

  .ph__ask {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px 28px;
  }

  .ph__tel {
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 600;
    letter-spacing: -0.03em;
    text-decoration: none;
  }

  .pl {
    background: var(--white);
    padding-bottom: var(--section-y);
  }

  .pl__bar {
    position: sticky;
    top: 0;
    z-index: 20;
    background: rgb(255 255 255 / 0.9);
    -webkit-backdrop-filter: blur(14px);
    backdrop-filter: blur(14px);
    border-bottom: 1px solid var(--steel-200);
  }

  .pl__bar-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 16px 32px;
    padding-block: 16px;
  }

  .pl__tabs {
    display: flex;
    gap: 1px;
    padding: 1px;
    background: var(--steel-200);
    border-radius: var(--radius);
  }

  .pl__tabs button {
    min-height: 48px;
    padding: 0 22px;
    border: 0;
    background: var(--white);
    font-weight: 600;
    cursor: pointer;
    transition:
      background-color 0.3s var(--ease-out),
      color 0.3s var(--ease-out);
  }

  .pl__tabs button:hover {
    background: var(--floor);
  }

  .pl__tabs button[aria-selected='true'] {
    background: var(--blue-900);
    color: var(--white);
  }

  .pl__search {
    position: relative;
    flex: 1 1 320px;
    max-width: 440px;
    display: flex;
    align-items: center;
    color: var(--steel-600);
  }

  .pl__search :global(svg) {
    position: absolute;
    left: 14px;
  }

  .pl__search input {
    width: 100%;
    min-height: 48px;
    padding: 0 16px 0 44px;
    border: 0;
    border-radius: var(--radius);
    background: var(--floor);
    box-shadow: inset 0 0 0 1px var(--steel-200);
    color: var(--ink);
  }

  .pl__search input::placeholder {
    color: var(--steel-500);
  }

  .pl__search input:focus {
    outline: none;
    box-shadow:
      inset 0 0 0 1px var(--blue-500),
      0 0 0 3px rgb(61 111 184 / 0.18);
  }

  .pl__panel {
    display: grid;
    grid-template-columns: 260px minmax(0, 1fr);
    min-width: 0;
    gap: clamp(32px, 5vw, 80px);
    padding-top: clamp(40px, 5vw, 72px);
  }

  .pl__panel[hidden] {
    display: none;
  }

  .pl__cats ul {
    position: sticky;
    top: 112px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .pl__cats a {
    display: block;
    padding: 8px 0;
    font-size: 0.9375rem;
    color: var(--steel-600);
    text-decoration: none;
    transition: color 0.3s var(--ease-out);
  }

  .pl__cats a:hover {
    color: var(--blue-700);
  }

  .pl__group {
    scroll-margin-top: 110px;
    margin-bottom: clamp(48px, 5vw, 72px);
  }

  .pl__group[hidden] {
    display: none;
  }

  .pl__group h2 {
    font-size: clamp(1.75rem, 3vw, 2.5rem);
    letter-spacing: -0.03em;
    margin-bottom: 20px;
  }

  table {
    width: 100%;
    border-collapse: collapse;
  }

  tr {
    border-top: 1px solid var(--steel-200);
    transition: background-color 0.25s var(--ease-out);
  }

  tbody tr:last-child {
    border-bottom: 1px solid var(--steel-200);
  }

  tr:hover {
    background: var(--floor);
  }

  tr[hidden] {
    display: none;
  }

  th[scope='row'] {
    text-align: left;
    font-weight: 400;
    padding: 16px 16px 16px 0;
  }

  td {
    text-align: right;
    white-space: nowrap;
    padding: 16px 0 16px 16px;
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 1.125rem;
  }

  td small {
    font-family: var(--font-body);
    font-weight: 400;
    font-size: 0.8125rem;
    color: var(--steel-600);
  }

  .pl__empty {
    padding: 32px 0;
    font-size: 1.125rem;
  }

  .pl__more {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 12px 48px;
    align-items: center;
    margin-top: clamp(40px, 5vw, 72px);
    padding: clamp(28px, 3.5vw, 48px);
    background: var(--floor);
    border-radius: var(--radius);
  }

  .pl__more h2 {
    font-size: clamp(1.5rem, 2.4vw, 2rem);
    letter-spacing: -0.03em;
  }

  .pl__more .btn {
    grid-column: 2;
    grid-row: 1 / span 2;
  }

  @media (max-width: 900px) {
    .ph__notes,
    .pl__panel,
    .pl__more {
      grid-template-columns: minmax(0, 1fr);
    }
    .pl__more .btn {
      grid-column: 1;
      grid-row: auto;
      justify-self: start;
    }
    .pl__cats ul {
      position: static;
      display: flex;
      gap: 8px;
      overflow-x: auto;
      padding-bottom: 8px;
    }
    .pl__cats a {
      white-space: nowrap;
      padding: 8px 14px;
      border-radius: 40px;
      box-shadow: inset 0 0 0 1px var(--steel-200);
    }
  }

  @media (max-width: 560px) {
    .pl__tabs {
      width: 100%;
    }
    .pl__tabs button {
      flex: 1;
      padding: 0 8px;
    }
  }
</style>
